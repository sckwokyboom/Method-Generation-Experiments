<configuration>

    <variable name="RETRIEVER_LOG_LEVEL" value="${retriever.log.level:-INFO}"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{30} - [%X{requestIndex:-}/%X{targetFile:-}] %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.experiment.retriever" level="${RETRIEVER_LOG_LEVEL}"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

</configuration>
